---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import { site, links, about, projects } from "../data/site";
import { getCollection } from "astro:content";

const posts = (await getCollection("writing", (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const statusUrl = import.meta.env.PUBLIC_STATUS_URL ?? "";
---

<Base title={site.fullName} description={site.description} bodyClass="home">
  <div class="top">
    <a class="me" href="/"><Mark />{site.name}</a>
    <div class="scrub" aria-hidden="true"><div class="ticks" id="ticks"></div><div class="bracket"></div><div class="bracket"></div></div>
    <span aria-hidden="true"></span>
  </div>

  <div class="strip" id="strip" role="list" aria-label="Sections" data-status-url={statusUrl}></div>

  <div class="bottom"><span>Scroll to browse, click to open</span></div>

  <noscript>
    <nav class="noscript">
      <a href="/writing">Writing</a>
      <a href={links.github.href}>GitHub</a>
      <a href={links.linkedin.href}>LinkedIn</a>
      <span>{links.email}</span>
    </nav>
  </noscript>

  <template data-section="about" data-name="About" data-title={site.fullName}>
    <div data-face>
      <div class="ring"></div>
      <div class="tease">{site.tagline}</div>
      <div class="status" hidden></div>
      <div class="word">{site.name}</div>
    </div>
    <div data-body>
      {about.paragraphs.map((p) => <p>{p}</p>)}
      <ul class="rows" style="margin-top:18px">
        {about.stack.map((s) => <li><span class="t">{s.label}</span><span class="m">{s.value}</span></li>)}
      </ul>
    </div>
  </template>

  <template data-section="projects" data-name="Projects" data-title="Projects">
    <div data-face>
      <div class="bar"></div>
      <div class="tease">Hudhud, Markd and more</div>
      <div class="word">Projects</div>
    </div>
    <div data-body>
      <ul class="rows">
        {projects.map((p) => (
          <li>
            {p.href ? <a class="t" href={p.href} target="_blank" rel="noopener">{p.name} ↗</a> : <span class="t">{p.name}</span>}
            <span class="m">{p.meta}</span>
            <span class="d">{p.description}</span>
          </li>
        ))}
      </ul>
    </div>
  </template>

  <template data-section="writing" data-name="Writing" data-href="/writing">
    <div data-face>
      <div class="lines"></div>
      <div class="tease">{posts.length === 1 ? "Saudi web infrastructure" : `${posts.length} pieces`}</div>
      <div class="word">Writing</div>
    </div>
  </template>

  <template data-section="contact" data-name="Contact" data-title="Contact">
    <div data-face>
      <div class="arrow"></div>
      <div class="tease">Say hello</div>
      <div class="word">Contact</div>
    </div>
    <div data-body>
      <ul class="rows">
        <li><a class="t" href={links.github.href} target="_blank" rel="noopener">GitHub ↗</a><span class="m">{links.github.label}</span></li>
        <li><a class="t" href={links.linkedin.href} target="_blank" rel="noopener">LinkedIn ↗</a><span class="m">{links.linkedin.label}</span></li>
        <li>
          <a class="t" href={`mailto:${links.email}`}>Email ↗</a>
          <span class="m"><span class="addr">{links.email}</span><button class="copy" type="button">Copy</button></span>
        </li>
      </ul>
    </div>
  </template>

  <script>
    import "../scripts/strip.ts";
  </script>
</Base>

<style is:global>
  body.home { height: 100%; overflow: hidden; }
  html:has(body.home) { height: 100%; }

  .top, .bottom {
    position: fixed; left: 0; right: 0; z-index: 3;
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding-left: max(20px, env(safe-area-inset-left, 0px)); padding-right: max(20px, env(safe-area-inset-right, 0px));
    font-family: var(--f-mono); font-size: 11px; color: var(--muted); letter-spacing: .02em;
    transition: opacity .35s;
  }
  .top { top: 0; padding-top: calc(18px + env(safe-area-inset-top, 0px)); }
  .bottom { bottom: 0; padding-bottom: calc(18px + env(safe-area-inset-bottom, 0px)); justify-content: center; }
  .top .me { view-transition-name: brand; display: inline-flex; align-items: center; gap: 8px; color: var(--fg); font-family: var(--f-body); font-size: 13px; font-weight: 500; text-decoration: none; }
  body.open .top, body.open .bottom { opacity: 0; pointer-events: none; }

  .scrub { position: relative; width: 168px; height: 12px; overflow: hidden; flex: none; }
  .ticks { position: absolute; inset: 0; display: flex; justify-content: space-between; align-items: center; }
  .ticks i { width: 1px; height: 9px; background: var(--muted); opacity: .55; }
  .bracket { position: absolute; top: 0; height: 12px; border: 1px solid var(--fg); border-radius: 2px; background: var(--bg); }

  .strip { position: fixed; inset: 0; touch-action: none; cursor: grab; transition: opacity .35s; }
  .strip.drag { cursor: grabbing; }
  body.open .strip { opacity: .15; pointer-events: none; }

  .card {
    all: unset; box-sizing: border-box; position: absolute; left: 0; top: 0;
    background: var(--card); cursor: pointer; container-type: inline-size; will-change: transform;
  }
  .card:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .card .lbl { position: absolute; left: 0; bottom: 100%; padding-bottom: 8px; font-family: var(--f-mono); font-size: 11px; color: var(--muted); white-space: nowrap; }
  .face { position: absolute; inset: 0; overflow: hidden; }
  .word { position: absolute; left: 5cqw; bottom: 2cqw; font-weight: 500; font-size: 21cqw; line-height: .9; letter-spacing: -.055em; white-space: nowrap; }
  .tease { position: absolute; left: 5cqw; top: 5cqw; font-family: var(--f-mono); font-size: max(11px, 1.9cqw); color: var(--muted); }

  .ring { position: absolute; right: -8cqw; top: -14cqw; width: 52cqw; aspect-ratio: 1; border-radius: 50%; border: 1.5px solid var(--accent); }
  .ring::after { content: ""; position: absolute; width: 4cqw; aspect-ratio: 1; border-radius: 50%; background: var(--accent); left: 50%; bottom: -2cqw; transform: translateX(-50%); }
  .bar { position: absolute; right: 5cqw; top: 5cqw; width: 16cqw; height: 1.5px; background: var(--accent); }
  .lines { position: absolute; right: 5cqw; top: 5cqw; width: 18cqw; height: 6cqw;
    background: linear-gradient(var(--accent), var(--accent)) 0 0 / 100% 1.5px no-repeat,
                linear-gradient(var(--accent), var(--accent)) 0 50% / 100% 1.5px no-repeat,
                linear-gradient(var(--accent), var(--accent)) 0 100% / 60% 1.5px no-repeat; }
  .arrow { position: absolute; right: 5cqw; top: 5cqw; width: 11cqw; aspect-ratio: 1; border-top: 1.5px solid var(--accent); border-right: 1.5px solid var(--accent); }
  .arrow::after { content: ""; position: absolute; right: 0; top: 0; width: 141%; height: 1.5px; background: var(--accent); transform-origin: 100% 50%; transform: rotate(-45deg); }
  .status { position: absolute; left: 5cqw; top: calc(5cqw + 2.4em); font-family: var(--f-mono); font-size: max(11px, 1.9cqw); color: var(--accent); display: flex; align-items: center; gap: .6em; }
  .status[hidden] { display: none; }
  .status::before { content: ""; width: .55em; height: .55em; border-radius: 50%; background: currentColor; animation: pulse 2.4s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: .3; } }

  .sheet:focus { outline: none; }
  .sheet { position: fixed; z-index: 10; background: var(--card); overflow: hidden; box-shadow: 0 30px 80px -40px rgba(0, 0, 0, .35); }
  .sheet .ghost { position: absolute; inset: 0; container-type: inline-size; pointer-events: none; }
  .sheet .inner { position: absolute; inset: 0; overflow-y: auto; padding: 28px 32px 32px; }
  .sheet header { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 22px; }
  .sheet h2 { margin: 0; font-size: clamp(34px, 7vw, 52px); font-weight: 500; letter-spacing: -.045em; line-height: 1; }
  .sheet p { margin: 0 0 12px; max-width: 58ch; }
  .copy { all: unset; cursor: pointer; font-family: var(--f-mono); font-size: 11px; color: var(--muted); border: 1px solid var(--rule); border-radius: 4px; padding: 2px 7px; }
  .copy:hover { color: var(--fg); }
  .copy:focus-visible { outline: 1px solid var(--accent); }

  .noscript { position: fixed; left: 0; right: 0; bottom: 60px; display: flex; gap: 16px; justify-content: center; font-family: var(--f-mono); font-size: 12px; }

  @media (max-width: 640px) { .sheet .inner { padding: 22px 20px 24px; } }
  @media (prefers-reduced-motion: reduce) { .status::before { animation: none; } }
</style>
